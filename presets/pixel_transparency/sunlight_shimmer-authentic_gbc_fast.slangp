# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
shaders = 7

shader0 = ../../handheld/shaders/pixel_transparency/shadow_cache_authentic_gbc_fast.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 6.0
scale_y0 = 2.0

shader1 = ../../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.1666666666666667
scale_y1 = 0.5

shader2 = ../../handheld/shaders/authentic_gbc/to_lin_fast.slang
filter_linear2 = false
scale_type2 = source
srgb_framebuffer2 = true

shader3 = ../../handheld/shaders/authentic_gbc/authentic_gbc_fast.slang
filter_linear3 = false
scale_type3 = viewport
alias3 = LCDInput

shader4 = ../../handheld/shaders/pixel_transparency/film_noise_cache.slang
filter_linear4 = false
scale_type4 = absolute
scale_x4 = 128
scale_y4 = 128

shader5 = ../../handheld/shaders/pixel_transparency/light_cache.slang
filter_linear5 = false
scale_type5 = absolute
scale_x5 = 256
scale_y5 = 256

shader6 = ../../handheld/shaders/pixel_transparency/sunlight_shimmer.slang
