scale_type_x3 = absolute
scale_x3 = 1

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/grids/lcd-grid-v2/input.slang
filter_linear4 = false
scale_type4 = viewport
scale4 = 1.0
alias4 = LCDInput

shader5 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/pt-3-film-noise-cache.slang
filter_linear5 = false
scale_type5 = absolute
scale_x5 = 128
scale_y5 = 128

shader6 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/pt-4-light-cache.slang
filter_linear6 = false
scale_type6 = absolute
scale_x6 = 256
scale_y6 = 256

shader7 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/grids/lcd-grid-v2/sunlight_shimmer.slang
filter_linear7 = true
wrap_mode7 = clamp_to_edge

RSUBPIX_R = "0.750000"
RSUBPIX_G = "0.000000"
