# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
# Experiment: shadow cache sized 3.1x1.1 (was 6x2); same lookups, ~72% less cache memory.
shaders = 5

shader0 = ../../../handheld/shaders/pixel_transparency/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 3.1
scale_y0 = 1.1

shader1 = ../../../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.3225806451612903
scale_y1 = 0.9090909090909091

shader2 = ../../../handheld/shaders/authentic_gbc/to_lin_fast.slang
filter_linear2 = false
scale_type2 = source
srgb_framebuffer2 = true

shader3 = ../../../handheld/shaders/authentic_gbc/authentic_gbc_fast.slang
filter_linear3 = false
scale_type3 = viewport
alias3 = LCDInput

shader4 = ../../../handheld/shaders/pixel_transparency/pixel_transparency.slang
filter_linear4 = false

PT_PALETTE = "1.0"
PT_POLARIZER = "0.0"
PT_HIGHLIGHTS = "0.0"