# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
shaders = 6

shader0 = ../../handheld/shaders/pixel_transparency/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 6.0
scale_y0 = 2.0

shader1 = ../../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.1666666666666667
scale_y1 = 0.5

shader2 = ../../handheld/shaders/lcd1x.slang
filter_linear2 = false
wrap_mode2 = clamp_to_border
mipmap_input2 = false
float_framebuffer2 = false
srgb_framebuffer2 = false
scale_type2 = viewport
alias2 = LCDInput

shader3 = ../../handheld/shaders/pixel_transparency/film_noise_cache.slang
filter_linear3 = false
scale_type3 = absolute
scale_x3 = 128
scale_y3 = 128

shader4 = ../../handheld/shaders/pixel_transparency/light_cache.slang
filter_linear4 = false
scale_type4 = absolute
scale_x4 = 256
scale_y4 = 256

shader5 = ../../handheld/shaders/pixel_transparency/sunlight_shimmer.slang
filter_linear5 = true
wrap_mode5 = clamp_to_edge

PT_DEFER_DITHER = "1.0"