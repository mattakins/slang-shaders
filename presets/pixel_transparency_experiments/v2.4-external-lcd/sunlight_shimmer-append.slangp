# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
shaders = 5

shader0 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/copy_lcd.slang
filter_linear0 = false
scale_type0 = viewport
alias0 = LCDInput

shader1 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/shadow_cache.slang
filter_linear1 = false
scale_type1 = absolute
scale_x1 = 1536
scale_y1 = 512

shader2 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/film_noise_cache.slang
filter_linear2 = false
scale_type2 = absolute
scale_x2 = 128
scale_y2 = 128

shader3 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/light_cache.slang
filter_linear3 = false
scale_type3 = absolute
scale_x3 = 256
scale_y3 = 256

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/sunlight_shimmer_append.slang
filter_linear4 = true
wrap_mode4 = clamp_to_edge

PT_DEFER_DITHER = "1.0"