# Pixel Transparency v2.4: generic append pipeline after separate LCD rendering.
shaders = 7

shader0 = "../../../motionblur/shaders/feedback.slang"
filter_linear0 = false

shader1 = ../../../handheld/shaders/authentic_gbc/to_lin_fast.slang
filter_linear1 = false
scale_type1 = source
srgb_framebuffer1 = true

shader2 = ../../../handheld/shaders/authentic_gbc/authentic_gbc_fast.slang
filter_linear2 = false
scale_type2 = viewport

shader3 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-append/copy_lcd.slang
filter_linear3 = false
scale_type3 = viewport
alias3 = LCDInput

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-append/shadow_cache.slang
filter_linear4 = false
scale_type4 = absolute
scale_x4 = 1536
scale_y4 = 512

filter_linear5 = true
scale_type5 = viewport
shader5 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-append/pixel_transparency.slang

shader6 = "../../../handheld/shaders/frontlit-reflective.slang"
filter_linear6 = true
scale_type6 = viewport
float_framebuffer6 = true

PT_SHADOW_OFFSET_X = 1.0
PT_SHADOW_OFFSET_Y = 1.0
PT_PALETTE = 1.0
PT_POLARIZER = 0.0
PT_HIGHLIGHTS = 0.0
textures = "dirt"
dirt = ../../../handheld/console-border/resources/dirty-glass.png
dirt_linear = true
dirt_wrap_mode = repeat
