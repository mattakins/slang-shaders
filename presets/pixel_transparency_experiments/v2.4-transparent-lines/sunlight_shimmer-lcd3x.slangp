# Integrated grid experiment: live placement with full-resolution effects.
shaders = 6

shader0 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/pt-0-shadow-cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 3.1
scale_y0 = 1.1

shader1 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/pt-1-restore-original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.3225806451612903
scale_y1 = 0.9090909090909091
alias1 = PTNativeInput

shader2 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/grids/lcd3x/input.slang
filter_linear2 = false
scale_type2 = viewport
alias2 = LCDInput

shader3 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/pt-3-film-noise-cache.slang
filter_linear3 = false
scale_type3 = absolute
scale_x3 = 128
scale_y3 = 128

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-transparent-lines/pt-4-light-cache.slang
