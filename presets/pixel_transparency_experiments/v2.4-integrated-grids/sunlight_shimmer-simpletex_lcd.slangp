# Integrated grid experiment: live placement with full-resolution effects.
shaders = 6

shader0 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 6.0
scale_y0 = 2.0

shader1 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.1666666666666667
scale_y1 = 0.5
alias1 = PTNativeInput

shader2 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/grids/simpletex_lcd/input.slang
filter_linear2 = true
wrap_mode2 = clamp_to_border
mipmap_input2 = false
float_framebuffer2 = false
srgb_framebuffer2 = false
scale_type2 = viewport
alias2 = LCDInput

shader3 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/film_noise_cache.slang
filter_linear3 = false
scale_type3 = absolute
scale_x3 = 128
scale_y3 = 128

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/light_cache.slang
filter_linear4 = false
scale_type4 = absolute
scale_x4 = 256
scale_y4 = 256

shader5 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/grids/simpletex_lcd/sunlight_shimmer.slang
filter_linear5 = true
wrap_mode5 = clamp_to_edge

textures = "BACKGROUND"
BACKGROUND = ../../../handheld/shaders/simpletex_lcd/png/2k/textured_paper.png
BACKGROUND_linear = false
GRID_INTENSITY = "0.65"
GRID_WIDTH = "0.65"
GRID_BIAS = "0.6"
DARKEN_GRID = "0.0"
DARKEN_COLOUR = "0.05"
BACKGROUND_INTENSITY = "0.0"
PT_DEFER_DITHER = "1.0"
PT_FUSED_LAYER = "0.0"
