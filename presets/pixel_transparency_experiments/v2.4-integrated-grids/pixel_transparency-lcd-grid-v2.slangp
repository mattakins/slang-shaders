# Integrated grid experiment: live placement with full-resolution effects.
shaders = 6

shader0 = ../../../handheld/shaders/pixel_transparency/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 6.0
scale_y0 = 2.0

shader1 = ../../../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.1666666666666667
scale_y1 = 0.5
alias1 = PTNativeInput

shader2 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/grid_v2_x.slang
filter_linear2 = false
scale_type_x2 = viewport
scale_x2 = 1.0
scale_type_y2 = absolute
scale_y2 = 2

shader3 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/grid_v2_y.slang
filter_linear3 = false
scale_type_y3 = viewport
scale_y3 = 1.0
scale_type_x3 = absolute
scale_x3 = 1

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/input-lcd-grid-v2.slang
filter_linear4 = false
scale_type4 = viewport
scale4 = 1.0
alias4 = LCDInput

shader5 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-integrated-grids/pixel_transparency-lcd-grid-v2.slang
filter_linear5 = false

RSUBPIX_R = "0.750000"
RSUBPIX_G = "0.000000"
RSUBPIX_B = "0.000000"
GSUBPIX_R = "0.000000"
GSUBPIX_G = "0.750000"
GSUBPIX_B = "0.000000"
BSUBPIX_R = "0.000000"
BSUBPIX_G = "0.000000"
BSUBPIX_B = "0.750000"
gain = "1.500000"
gamma = "2.200000"
blacklevel = "0.000000"
ambient = "0.000000"
BGR = "0.000000"
PT_PALETTE = "1.0"
PT_POLARIZER = "0.0"
PT_HIGHLIGHTS = "0.0"
PT_FUSED_LAYER = "0.0"
