# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
shaders = 6

shader0 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 3.1
scale_y0 = 1.1

shader1 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.3225806451612903
scale_y1 = 0.9090909090909091

shader2 = ../../../handheld/shaders/lcd3x.slang
filter_linear2 = false
scale_type2 = viewport
alias2 = LCDInput

shader3 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/film_noise_cache.slang
filter_linear3 = false
scale_type3 = absolute
scale_x3 = 128
scale_y3 = 128

shader4 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/light_cache.slang
filter_linear4 = false
scale_type4 = absolute
scale_x4 = 256
scale_y4 = 256

shader5 = ../../../handheld/shaders/pixel_transparency_experiments/v2.4-external-lcd/sunlight_shimmer.slang
