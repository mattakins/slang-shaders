# Grid after full-resolution effects, followed by final display dither.
shaders = 5

shader0 = ../../../handheld/shaders/pixel_transparency/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 3.1
scale_y0 = 1.1

shader1 = ../../../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.3225806451612903
scale_y1 = 0.9090909090909091
alias1 = LCDInput

shader2 = ../../../handheld/shaders/pixel_transparency/grid_after/pixel_transparency.slang
filter_linear2 = false
scale_type2 = viewport
alias2 = PTEffects

shader3 = ../../../handheld/shaders/zfast_lcd.slang
filter_linear3 = false
float_framebuffer3 = true
scale_type3 = viewport

shader4 = ../../../handheld/shaders/pixel_transparency/grid_after/dither.slang
filter_linear4 = false

PT_PALETTE = "1.0"
PT_POLARIZER = "0.0"
PT_HIGHLIGHTS = "0.0"
