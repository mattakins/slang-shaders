# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
shaders = 4

shader0 = ../../handheld/shaders/pixel_transparency/shadow_cache_zfast_lcd.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 6.0
scale_y0 = 2.0

shader1 = ../../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.1666666666666667
scale_y1 = 0.5

shader2 = ../../handheld/shaders/zfast_lcd.slang
filter_linear2 = true
scale_type2 = viewport
alias2 = LCDInput

shader3 = ../../handheld/shaders/pixel_transparency/pixel_transparency.slang
filter_linear3 = false

PT_PALETTE = "1.0"
PT_POLARIZER = "0.0"
PT_HIGHLIGHTS = "0.0"