# Pixel Transparency v2.4: cached shadows with separate LCD rendering.
shaders = 7

shader0 = ../handheld/shaders/pixel_transparency/shadow_cache.slang
filter_linear0 = false
scale_type0 = source
scale_x0 = 3.1
scale_y0 = 1.1

shader1 = ../handheld/shaders/pixel_transparency/restore_original.slang
filter_linear1 = false
scale_type1 = source
scale_x1 = 0.3225806451612903
scale_y1 = 0.9090909090909091

shader2 = ../handheld/shaders/motionblur-feedback.slang
filter_linear2 = false
alias2 = MotionBlur

shader3 = ../handheld/shaders/authentic_gbc/to_lin_fast.slang
filter_linear3 = false
scale_type3 = source
srgb_framebuffer3 = true

shader4 = ../handheld/shaders/authentic_gbc/authentic_gbc_fast.slang
filter_linear4 = false
scale_type4 = viewport
alias4 = LCDInput

shader5 = ../handheld/shaders/pixel_transparency/pixel_transparency.slang
filter_linear5 = true
scale_type5 = viewport

shader6 = "../handheld/shaders/frontlit-reflective.slang"
filter_linear6 = true
scale_type6 = viewport
float_framebuffer6 = true

PT_SHADOW_OFFSET_X = 1.0
PT_SHADOW_OFFSET_Y = 1.0
PT_PALETTE = 1.0
PT_POLARIZER = 0.0
PT_HIGHLIGHTS = 0.0
textures = "dirt"
dirt = ../handheld/console-border/resources/dirty-glass.png
dirt_linear = true
dirt_wrap_mode = repeat
